CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# ESP-IDF 5.4 Bluedroid Mesh uses legacy LE scan/advertising HCI commands.
# C3 defaults to BLE 5.0 host features; do not mix extended and legacy HCI.
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTS_SEND_SERVICE_CHANGE_MANUAL=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
# Mesh duplicate filtering requires address AND content, not address alone.
CONFIG_BT_CTRL_SCAN_DUPL_TYPE_DATA_DEVICE=y
# The slave is provisioned by the Master over PB-ADV.  It is not a phone
# GATT endpoint, so keep the GATT provisioning/proxy stack out of this role.
CONFIG_BLE_MESH_PB_GATT=n
CONFIG_BLE_MESH_GATT_PROXY_SERVER=n
CONFIG_BLE_MESH_PROXY=n
CONFIG_BLE_MESH_RELAY=y
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_SUPPORT_BLE_ADV=y
CONFIG_BLE_MESH_V11_SUPPORT=n
CONFIG_BLE_MESH_STORE_TIMEOUT=0
CONFIG_BLE_MESH_SEQ_STORE_RATE=128
CONFIG_BLE_MESH_CRPL=128
CONFIG_BLE_MESH_ADV_BUF_COUNT=40
CONFIG_BLE_MESH_RX_SEG_MSG_COUNT=16
CONFIG_BLE_MESH_TX_SEG_MSG_COUNT=8
CONFIG_BLE_MESH_RX_SDU_MAX=96
CONFIG_BLE_MESH_TX_SEG_MAX=8
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
# Mesh delayed work and Bluedroid GATT/SMP share the OSI alarm pool.
# 50 slots are exhausted on phone connect with RX=16 / TX=8; reserve headroom.
CONFIG_BT_ALARM_MAX_NUM=128
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_COMPILER_CXX_EXCEPTIONS=n
# Recovery handshake uses HKDF-SHA256 and AES-GCM from the SDK mbedTLS.
CONFIG_MBEDTLS_HKDF_C=y

# Super Mini onboard native USB Serial/JTAG: both logs and maintenance commands.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BLE_MESH_PROVISIONER=n
CONFIG_BLE_MESH_CFG_CLI=n
